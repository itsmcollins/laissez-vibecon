# ----------------------------------------
# Frontend configuration (copy to frontend/.env)
# ----------------------------------------
REACT_APP_PRIVY_APP_ID=app_your_privy_app_id_here

# ----------------------------------------
# Backend configuration (copy to backend/.env)
# ----------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=supabase_service_role_key
PRIVY_APP_ID=app_your_privy_app_id_here
# Optional: override if Privy publishes a different JWKS location
# PRIVY_JWKS_URL=https://auth.privy.io/api/v1/k/keys

# Optional integrations used elsewhere in the project
# EMERGENT_LLM_KEY=your_emergent_llm_api_key

